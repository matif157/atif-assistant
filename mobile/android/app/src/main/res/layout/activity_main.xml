<?xml version="1.0" encoding="utf-8"?>
<!-- Launch UI: dark splash with live boot status, an honest error screen
     with RETRY + COPY DIAGNOSTICS (instead of the dead WebView error page),
     and the WebView itself, which stays invisible until the server answers. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0e14">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/boot_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b0e14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="Atif Assistant logo"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.06"
            android:text="ATIF ASSISTANT"
            android:textColor="#dfe6f2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/boot_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Starting the offline engine..."
            android:textColor="#7c8aa3"
            android:textSize="13sp" />

        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:indeterminateTint="#5eead4" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/boot_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b0e14"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="COULDN'T START ATIF"
                android:textColor="#f87171"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/boot_error_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="The offline engine failed to start."
                android:textColor="#7c8aa3"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/boot_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#5eead4"
                    android:minWidth="110dp"
                    android:text="RETRY"
                    android:textColor="#0b0e14"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/boot_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="#161c29"
                    android:minWidth="150dp"
                    android:text="COPY DIAGNOSTICS"
                    android:textColor="#dfe6f2"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Opt-in fingerprint gate: sits above everything until the user
         authenticates (or the device has nothing to authenticate with). -->
    <LinearLayout
        android:id="@+id/lock_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b0e14"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Atif Assistant logo"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.06"
            android:text="ATIF ASSISTANT"
            android:textColor="#dfe6f2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lock_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="Unlock with your fingerprint to open Atif Assistant."
            android:textColor="#7c8aa3"
            android:textSize="13sp" />

        <Button
            android:id="@+id/lock_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:backgroundTint="#5eead4"
            android:minWidth="140dp"
            android:text="UNLOCK"
            android:textColor="#0b0e14"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
