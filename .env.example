# Atif Assistant environment.
#
# At least ONE model key is needed for reasoning. Retrieval, the Pattern
# Radar and the brake all work without one - only generation is disabled.
#
# All three below have free tiers. Groq is fastest to set up and is the
# first provider tried.
#
# Get a key:  https://console.groq.com/keys        (free)
#             https://aistudio.google.com/apikey   (free)
#             https://openrouter.ai/keys           (free tier, some models)

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# All of the above can also be set at runtime from the Settings sheet, which
# overrides these values. Model overrides (optional):
# ATIF_ASSISTANT_GROQ_MODEL=openai/gpt-oss-120b
# ATIF_ASSISTANT_GEMINI_MODEL=gemini-2.0-flash
# OpenRouter's paid models need credits. Point at a `:free` model that answers.
# ATIF_ASSISTANT_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional local model via Ollama - no internet needed for generation.
# Install:  brew install ollama && ollama pull llama3.2
# Then set ATIF_ASSISTANT_PROVIDERS=ollama to use it alone.
ATIF_ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
ATIF_ASSISTANT_OLLAMA_MODEL=llama3.2

# Provider order and tuning (optional)
# ATIF_ASSISTANT_PROVIDERS=groq,gemini,openrouter,ollama
# ATIF_ASSISTANT_RETRIEVAL_LIMIT=5
# ATIF_ASSISTANT_PATTERN_LIMIT=2
# ATIF_ASSISTANT_PORT=8770

# Where the seeded archive lives (optional)
# ATIF_ASSISTANT_ARCHIVE_DIR=/path/to/asked-questions-archive