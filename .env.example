# Raees environment.
#
# At least ONE model key is needed for reasoning. Retrieval, the Pattern
# Radar and the brake all work without one - only generation is disabled.
#
# All three below have free tiers. Groq is fastest to set up and is the
# first provider tried.
#
# Get a key:  https://console.groq.com/keys        (free)
#             https://aistudio.google.com/apikey   (free)
#             https://openrouter.ai/keys           (free tier, some models)

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional local model via Ollama - no internet needed for generation.
# Install:  brew install ollama && ollama pull llama3.2
# Then set RAEES_PROVIDERS=ollama to use it alone.
RAEES_OLLAMA_URL=http://127.0.0.1:11434
RAEES_OLLAMA_MODEL=llama3.2

# Provider order and tuning (optional)
# RAEES_PROVIDERS=groq,gemini,openrouter,ollama
# RAEES_RETRIEVAL_LIMIT=5
# RAEES_PATTERN_LIMIT=2
# RAEES_PORT=8770

# Where the seeded archive lives (optional)
# RAEES_ARCHIVE_DIR=/path/to/asked-questions-archive